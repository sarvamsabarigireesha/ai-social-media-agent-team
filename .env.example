# ============================================================================
# AI Native Social Media Agent Team — 100% FREE Configuration (.env)
# Copy this file to `.env` if you want keys saved permanently on disk,
# OR simply paste any free key directly inside the web dashboard at http://localhost:8000!
# ============================================================================

# Option 1: Google Gemini Free API Key (https://aistudio.google.com/apikey — $0, no card needed)
GEMINI_API_KEY=

# Option 2: Groq Free API Key (https://console.groq.com/keys — $0, ultra-fast Llama 3.3 70B)
GROQ_API_KEY=

# Option 3: OpenRouter Free API Key (https://openrouter.ai/keys — free `:free` models)
OPENROUTER_API_KEY=

# Option 4: Local Offline Ollama URL (https://ollama.com — $0 local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server Port
PORT=8000
